+#ifdef DYNARMIC_DISPATCH_COUNTERS
+u64 A32AddressSpace::HashGuestCode(u32 start, u32 end) const {
+    // Through the callback: a block may end at an unreadable word.
+    u64 hash = 0xcbf29ce484222325ull;  // FNV-1a over words
+    for (u64 a = start & ~u64{3}; a < end; a += 4) {
+        const std::optional<u32> word = conf.callbacks->MemoryReadCode(static_cast<u32>(a));
+        hash = (hash ^ (word ? *word : 0xFFFFFFFFull << 32)) * 0x100000001b3ull;
+    }
+    return hash;
+}
+
+std::size_t A32AddressSpace::DiagChangedCode(std::string& ranges) {
+    std::unique_lock lock{cache_mutex};
+    std::size_t persisting = 0;
+    for (auto it = code_snapshots.begin(); it != code_snapshots.end();) {
+        if (!Get(IR::LocationDescriptor{it->first})) {
+            it = code_snapshots.erase(it);  // invalidated: not stale
+            continue;
+        }
+        CodeSnapshot& snap = it.value();
+        const bool changed = HashGuestCode(snap.start, snap.end) != snap.hash;
+        if (changed && snap.changed) {
+            if (persisting++ < 8) {
+                char line[32];
+                std::snprintf(line, sizeof(line), " %08x-%08x", snap.start, snap.end);
+                ranges += line;
+            }
+        }
+        snap.changed = changed;
+        ++it;
+    }
+    return persisting;
+}
+#endif
