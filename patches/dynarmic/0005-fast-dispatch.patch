+CodePtr A32AddressSpace::Dispatch(A32JitState& state) {
+    const IR::LocationDescriptor descriptor = state.GetLocationDescriptor();
+    // Read first: a block invalidated during the lookup then goes in as old.
+    const u64 gen = generation.load(std::memory_order_acquire);
+    const CodePtr entry = GetOrEmit(descriptor);
+    if (!entry) {
+        return GetOrEmitForThread(descriptor);
+    }
+    if (state.fast_dispatch_table) {
+        const u64 value = descriptor.Value();
+        const u64 index = ((value >> 32) ^ (value >> 1)) & (FastDispatchEntries - 1);
+        state.fast_dispatch_table[index] = {value, mcl::bit_cast<u64>(entry), gen, 0};
+    }
+    return entry;
+}
