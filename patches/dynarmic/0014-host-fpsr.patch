     /// to data races and deadlocks.
     Unsafe_IgnoreGlobalMonitor = 0x00100000,
+
+    /// This is an UNSAFE optimization (ab-port, arm64 A32). The guest's cumulative
+    /// floating-point exception flags (FPSCR IOC..IDC, QC) live in the host FPSR for
+    /// a whole Run/Step instead of being cleared before the first FP operation of each
+    /// block and merged into the state at its end and before every host call (each
+    /// FPSR write serialises the pipeline). Inexact: flags raised by host code that
+    /// guest code calls (callbacks, fallbacks), and the QC of A32 packed saturating
+    /// ops, also reach the guest's flags.
+    Unsafe_HostFpsr = 0x00200000,
 };
 
