+AddressSpace::HostPcKind AddressSpace::LocateHostPc(const void* host_pc, IR::LocationDescriptor* loc) {
+    const auto* p = static_cast<const std::byte*>(host_pc);
+    const auto* base = reinterpret_cast<const std::byte*>(mem.ptr());
+    if (p < base || p >= base + code_cache_size) {
+        return HostPcKind::Outside;
+    }
+    std::shared_lock lock{cache_mutex};
+    const auto location = ReverseGetLocation(const_cast<CodePtr>(p));
+    if (!location) {
+        return HostPcKind::Stub;
+    }
+    *loc = *location;
+    return HostPcKind::Block;
+}
