+// The generic timer, readable from user mode under Linux (the kernel enables
+// it; the vDSO's clocks read it), served from the host's own counter with no
+// coprocessor attached (ab-port). The frontend accepts these reads and every
+// backend emits them, from these two tests only.
+
+// CNTFRQ: MRC p15, 0, Rt, c14, c0, 0.
+constexpr bool IsGenericTimerCntfrq(std::size_t coproc_no, bool two, std::size_t opc1, CoprocReg CRn, CoprocReg CRm, std::size_t opc2) {
+    return coproc_no == 15 && !two && opc1 == 0 && CRn == CoprocReg::C14 && CRm == CoprocReg::C0 && opc2 == 0;
+}
+
+// CNTVCT: MRRC p15, 1, Rt, Rt2, c14.
+constexpr bool IsGenericTimerCntvct(std::size_t coproc_no, bool two, std::size_t opc, CoprocReg CRm) {
+    return coproc_no == 15 && !two && opc == 1 && CRm == CoprocReg::C14;
+}
+
+}  // namespace Dynarmic::A32
