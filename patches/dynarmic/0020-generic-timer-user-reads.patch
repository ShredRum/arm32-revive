+// PC tools only (ab-port): the generic timer of an arm64 host has no x64
+// equivalent, so CNTVCT counts the host's steady clock at 24 MHz (CNTFRQ).
+static u64 HostCntvct() {
+    return static_cast<u64>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                std::chrono::steady_clock::now().time_since_epoch())
+                                .count()) *
+           3 / 125;
+}
